# Endereço permitido para acessar a API durante o desenvolvimento
WEB_ORIGIN=http://localhost:5173

# Porta da API
PORT=3333

# Em produção: URL pública do frontend e proxy HTTPS da API
PUBLIC_WEB_URL=
TRUST_PROXY=0

# Troque esta chave antes de publicar o sistema
JWT_SECRET=troque-por-uma-chave-longa-e-segura

# Acesso exclusivo ao painel geral do desenvolvedor
DEV_EMAIL=seu-email@exemplo.com
DEV_PASSWORD=crie-uma-senha-forte

# Neon PostgreSQL (use a URL pooled para a aplicação)
DATABASE_URL=postgresql://usuario:senha@seu-endpoint-pooler.neon.tech/neondb?sslmode=require

# Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Recuperação de senha por e-mail (opcional no desenvolvimento)
# Crie uma chave em resend.com e use um remetente verificado.
RESEND_API_KEY=
RESET_FROM_EMAIL=ER Replay <replay@seudominio.com>

# Em desenvolvimento, o link de teste aparece na própria tela
# quando o Resend ainda não estiver configurado.
NODE_ENV=development
