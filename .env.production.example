# =========================
# API / computador da arena
# =========================
NODE_ENV=production
PORT=3333
TRUST_PROXY=1

# URL pública do site hospedado no Vercel (sem barra no final)
PUBLIC_WEB_URL=https://seu-er-replay.vercel.app
WEB_ORIGIN=https://seu-er-replay.vercel.app

# Gere uma chave longa e exclusiva (mínimo 32 caracteres)
JWT_SECRET=troque-por-uma-chave-segura-com-mais-de-32-caracteres

# Conta mestre do desenvolvedor
DEV_EMAIL=seu-email@exemplo.com
DEV_PASSWORD=troque-por-uma-senha-forte

# Neon PostgreSQL
DATABASE_URL=postgresql://usuario:senha@endpoint-pooler.neon.tech/neondb?sslmode=require

# Cloudinary - obrigatório na beta online
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Recuperação de senha por e-mail (opcional no primeiro beta)
RESEND_API_KEY=
RESET_FROM_EMAIL=ER Replay <replay@seudominio.com>
