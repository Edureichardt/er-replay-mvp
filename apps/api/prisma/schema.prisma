generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DEVELOPER
  ADMIN
  PLAYER
}
enum CameraType {
  WEBCAM
  RTSP
  MJPEG
}
enum CameraStatus {
  UNTESTED
  ONLINE
  OFFLINE
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  role             Role     @default(PLAYER)
  createdAt        DateTime @default(now())
  licenseExpiresAt DateTime?
  licenseDays      Int?
  accessActive     Boolean  @default(true)
  lastPaymentAt    DateTime?
  ownedArenas      Arena[]  @relation("ArenaOwner")
  arenaId          String?
  arena            Arena?   @relation("ArenaPlayers", fields: [arenaId], references: [id], onDelete: SetNull)
  replays          Replay[]
  agentPairingCodes AgentPairingCode[] @relation("AgentPairingOwner")
  captureAgents     CaptureAgent[] @relation("CaptureAgentOwner")
  ownedReplayJobs   ReplayJob[] @relation("ReplayJobOwner")
  replayJobs        ReplayJob[] @relation("ReplayJobUser")
  @@index([arenaId])
}

model Arena {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  defaultSeconds Int      @default(30)
  retentionDays  Int      @default(7)
  watermarkUrl   String?
  activeCameraId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  ownerId        String?
  owner          User?    @relation("ArenaOwner", fields: [ownerId], references: [id])
  cameras        Camera[]
  replays        Replay[]
  players        User[]   @relation("ArenaPlayers")
  replayJobs     ReplayJob[]
  @@index([ownerId])
}

model Camera {
  id String @id @default(uuid())
  arenaId String
  arena Arena @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  name String
  type CameraType
  host String
  port Int @default(554)
  username String?
  password String?
  path String
  transport String @default("tcp")
  active Boolean @default(true)
  status CameraStatus @default(UNTESTED)
  lastTestedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  replays Replay[]
  replayJobs ReplayJob[]
}

model Replay {
  id String @id @default(uuid())
  cameraId String
  camera Camera @relation(fields: [cameraId], references: [id])
  arenaId String
  arena Arena @relation(fields: [arenaId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  seconds Int
  filename String
  url String
  cloudPublicId String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId, createdAt])
  @@index([arenaId, createdAt])
  @@index([expiresAt])
}

model AgentPairingCode {
  id        String   @id
  ownerId   String
  codeHash  String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  owner     User     @relation("AgentPairingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
}

model CaptureAgent {
  id          String   @id
  ownerId     String
  name        String
  machineName String?
  tokenHash   String   @unique
  active      Boolean  @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  owner       User     @relation("CaptureAgentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
}


model ReplayJob {
  id         String   @id
  ownerId    String
  arenaId    String
  arenaCode  String
  cameraId   String
  userId     String
  seconds    Int
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  claimedAt  DateTime?
  finishedAt DateTime?
  replayId   String?
  error      String?
  owner      User     @relation("ReplayJobOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  arena      Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  camera     Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  user       User     @relation("ReplayJobUser", fields: [userId], references: [id], onDelete: Cascade)
  @@index([ownerId, status, createdAt])
  @@index([userId, createdAt])
}
